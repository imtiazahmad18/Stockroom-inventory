# Required backend settings.
DATABASE_URL=file:./inventory.db
JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings used to deliver password reset codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Stockroom <no-reply@example.com>

# Safepay subscription billing (create a USD $10 / monthly plan in Safepay)
SAFEPAY_ENV=sandbox
SAFEPAY_HOST=https://sandbox.api.getsafepay.com
SAFEPAY_CHECKOUT_HOST=https://sandbox.api.getsafepay.com
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_PLAN_ID=
SAFEPAY_WEBHOOK_SECRET=
APP_URL=http://localhost:5173

# Local development only. This bypass works only when NODE_ENV=development.
NODE_ENV=development
BILLING_DEV_BYPASS=false
